# .gitignore for GitHub Pages
# Ignore all backup folders and their contents
backup/
/backup/*

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test

# production
/build

# misc
.DS_Store
*.pem
.idea

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Official SweetHome3DJS downloads / diff reports
.official-cache/
.official/
.smoke-tmp/
tmp-scratchomised/
tmp-plugin/
scripts/diff-official-report.md
scripts/audit-missing-imports-report.md

# Basic Jekyll gitignores (synchronize to Jekyll.gitignore)
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata